# Copie para .env e preencha. NUNCA versione o .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
IA_INTERVALO_S=600

# TSE (oficial). Para ensaio: TSE_BASE=https://resultados-sim.tse.jus.br  TSE_AMBIENTE=simulado  TSE_CICLO=ele2026
TSE_BASE=https://resultados.tse.jus.br
TSE_AMBIENTE=oficial
TSE_RPS=15            # requisições/s ao TSE (teto do briefing: 20; limite do TSE: 100)
POLL_S=20             # intervalo do ciclo do coletor (s)
ELEICAO_BASE=6257     # 1º turno
ELEICAO_ALVO=6258     # 2º turno

# Motor
MIN_RECALC_S=45
N_SIM=5000

# Banco
POSTGRES_PASSWORD=troque-esta-senha

# Web
WEB_PORT=8080
DOMINIO=resultados-eleicao.yvesscopy.com

# Alertas (opcionais)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
ALERT_WHATSAPP=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=
